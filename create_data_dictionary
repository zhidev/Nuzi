def is_line_zone(line, is_zone_name, past_first_zone_border, zone_name):
    print(f"is_line_zone called on {line}.")
    #Conditionals for Zone section
    line = line.strip()
    if line == '------':
        if past_first_zone_border[0]:
            #if this flag is true and we see ----- means we're at the bottom half
            past_first_zone_border[0] = False
            return True
        else:
            #else if we see ----- and flag is false this means first instance,
            #so next is the zone name and we set the flag that we past the first instance
            past_first_zone_border[0] = True
            is_zone_name[0] = True
            return True
    print(f"{line} is not ------ now we check {is_zone_name} as is_zone_name")
    if is_zone_name[0] :
        #This checks if zone name is empty
        if zone_assigned[0]:
            export_trainer_list_to_json(zone_name[0])
        #if we're expecting a zone name, we update zone name and reset the flag
        zone_name[0] = line
        zone_assigned[0] = True
        is_zone_name[0] = False
        return True
    else:
        return False
    

def export_trainer_list_to_json(zone_name):
