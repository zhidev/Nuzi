def is_line_zone(line, is_zone_name, past_first_zone_border, zone_name):
    #Conditionals for Zone section
    line = line.strip()
    if line == '------':
        if past_first_zone_border[0]:
            #if this flag is true and we see ----- means we're at the bottom half
            past_first_zone_border[0] = False
            return True
        else:
            #else if we see ----- and flag is false this means first instance,
            #so next is the zone name and we set the flag that we past the first instance
            past_first_zone_border[0] = True
            is_zone_name[0] = True
            return True
    if is_zone_name[0] :
        #This checks if zone name is empty, if it isn't empty we triger zone change
        if zone_assigned[0]:
            print(f"{zone_name[0]} IS THE ZONE NAME FOUND CALLING ZONE CHANGED")
            zone_changed_from(zone_name[0])
        else:
            #Else we're in the beginning so we set our initial split to Brawly
            # individual_zone_dictionary.update({'split_name' : split_name[split_count]})
            # print(f"PRINTING SPLIT COUNT: {split_count}")
            # print(split_name)
            pass
        #if we're expecting a zone name, we update zone name and reset the flag
        check_and_update_split_change(zone_name[0], line)
        zone_name[0] = line
        zone_assigned[0] = True
        is_zone_name[0] = False
        return True
    else:
        return False
    

