    print(f"Start of new for loop, is_zone_name: {is_zone_name}, past_first_zone_border: {past_first_zone_border}")
    #Conditionals for Zone section. If true we go to next line
    if is_line_zone(line, is_zone_name, past_first_zone_border, zone_name):
        print(f"is line zone passed on line: {line}")
        continue
    if line == "":
    #If empty line it means we finished current trainer if there is data to push
        is_trainer_name_next = True
        if new_data_entry:
            trainer_dict = {
                'trainer' : trainer_name,
                'pokemon_list' : loop_pokemon_list
            }
            trainer_list.append(trainer_dict)
            #erase current pokemon listfor the next trainer
            loop_pokemon_list = []
            #we no longer expect to push a trainer dictionary in
            new_data_entry = False
        continue
    #If its trainer name next expected, and its not zone name due to previous if blocks
    # we assign out trainer name and go to next loop iteration
    if is_trainer_name_next:
        trainer_name = line
        print(f"Trainer name {line} assigned")
        is_trainer_name_next = False
        continue

    #Apply our regex
    match = re.search(pokemon_pattern,line)
    if match:   
        pokemon = match.group(1)
        item = match.group(2)
        moves = match.group(3)
        moves = moves.split(", ")
        ability = match.group(4)
        print(f"{pokemon} FOUND")

        #create individual pokemon dict to insert to pokemon list
        pokemon_dict = {
            'pokemon' : pokemon,
            'item' : item,
            'moves' : moves,
            'ability' : ability
         }
        loop_pokemon_list.append(pokemon_dict)
        new_data_entry = True

    


