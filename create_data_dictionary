def pokemon_string_matched(match):
        pokemon = match.group(1)
        item = match.group(2)
        moves = match.group(3)
        moves = moves.split(", ")
        ability = match.group(4)
        # print(f"{pokemon} FOUND")

        #create individual pokemon dict to insert to pokemon list
        pokemon_dict = {
            'pokemon' : pokemon,
            'item' : item,
            'moves' : moves,
            'ability' : ability
         }
        pokemon_list.append(pokemon_dict)


